{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "web#build": {
      "dependsOn": [],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "web#dev": {
      "cache": false,
      "persistent": true
    },
    "crm#build": {
      "dependsOn": [],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "crm#dev": {
      "cache": false,
      "persistent": true
    },
    "auth#build": {
      "dependsOn": [],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "auth#dev": {
      "cache": false,
      "persistent": true
    },
    "system-admin#build": {
      "dependsOn": [],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "system-admin#dev": {
      "cache": false,
      "persistent": true
    }
  }
}