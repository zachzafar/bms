{
  "name": "AMS",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "cd apps/api && PORT=3001 pnpm dev",
    "dev:web": "cd apps/web && PORT=3000 NEXT_PUBLIC_API_URL=http://localhost:3001 pnpm dev",
    "dev:all": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "cd apps/api && pnpm db:generate",
    "db:migrate": "cd apps/api && pnpm db:migrate",
    "db:push": "cd apps/api && pnpm db:push"
  },
  "devDependencies": {
    "@types/react-big-calendar": "^1.16.3",
    "prettier": "^3.2.5",
    "turbo": "^2.2.3",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "date-fns": "^3.6.0",
    "luxon": "^3.7.1",
    "moment": "^2.30.1",
    "react-big-calendar": "^1.19.4",
    "zod": "3.23.8"
  }
}
